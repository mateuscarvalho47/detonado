{
  "name": "backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @detonado/shared build && tsx watch --env-file=.env src/server.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm --filter @detonado/shared build && pnpm clean && prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && pnpm check:runtime",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:clean": "tsx --env-file=.env prisma/clean.ts",
    "db:reset": "prisma migrate reset",
    "test": "pnpm --filter @detonado/shared build && vitest run",
    "test:watch": "pnpm --filter @detonado/shared build && vitest",
    "test:cov": "pnpm --filter @detonado/shared build && vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "gen:module": "tsx scripts/create-module.ts",
    "gen:bruno": "tsx --env-file=.env scripts/gen-bruno.ts",
    "check:runtime": "node --input-type=module -e \"await import('@detonado/shared'); await import('./dist/modules/library/library.service.js'); console.log('Production imports OK')\""
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@detonado/shared": "workspace:^",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "connect-redis": "^9.0.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "howlongtobeat-ts": "^1.3.1",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  }
}
