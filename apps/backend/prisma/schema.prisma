// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String               @id @default(cuid())
  email                      String               @unique
  passwordHash               String
  emailVerified              Boolean              @default(false)
  emailVerificationToken     String?              @unique
  emailVerificationExpiresAt DateTime?
  preferredPlatform          String?
  consentedAt                DateTime?
  sessionVersion             Int                  @default(0)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  collections                Collection[]
  tags                       Tag[]
  playSessions               PlaySession[]
  savedFilters               SavedFilter[]
  libraryEntries             LibraryEntry[]
  passwordResetTokens        PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

enum LibraryStatus {
  WISHLIST
  BACKLOG
  PLAYING
  PAUSED
  COMPLETED
  DROPPED
}

enum HltbStatus {
  FOUND
  MISS
  FAILED
}

model LibraryEntry {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  igdbId            Int
  name              String
  coverUrl          String?
  genres            String[]
  platforms         String[]
  status            LibraryStatus
  userPlatform      String?
  rating            Int?
  baseHours         Decimal?          @db.Decimal(6, 1)
  lastSessionAt     DateTime?
  activeCampaignId  String?
  activeCampaign    Campaign?         @relation("ActiveCampaign", fields: [activeCampaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaigns         Campaign[]        @relation("EntryCampaigns")
  completionGoal    CompletionGoal    @default(MAIN)
  sources           GameSource[]
  checklist         ChecklistItem[]
  collections       CollectionEntry[]
  tags              TagEntry[]
  sessions          PlaySession[]
  hoursPlayed       Decimal?          @db.Decimal(6, 1)
  notes             String?
  completedAt       DateTime?
  hltbMain          Float?
  hltbMainExtra     Float?
  hltbCompletionist Float?
  hltbStatus        HltbStatus?
  // Lower comes first. Set only while status is BACKLOG.
  queuePosition     Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([id, userId])
  @@unique([userId, igdbId])
  @@index([userId, status])
  @@index([userId, status, queuePosition])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model PlaySession {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId         String
  entry           LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        Campaign     @relation(fields: [campaignId, entryId, userId], references: [id, entryId, userId], onDelete: Cascade)
  clientId        String
  playedAt        DateTime
  durationMinutes Int
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, clientId])
  @@index([entryId, playedAt])
}

model Collection {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  entries   CollectionEntry[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, name])
  @@unique([id, userId])
}

model Tag {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  entries   TagEntry[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, name])
  @@unique([id, userId])
}

model CollectionEntry {
  entryId      String
  collectionId String
  userId       String
  entry        LibraryEntry @relation(fields: [entryId, userId], references: [id, userId], onDelete: Cascade)
  collection   Collection   @relation(fields: [collectionId, userId], references: [id, userId], onDelete: Cascade)

  @@id([entryId, collectionId])
  @@index([collectionId])
}

model TagEntry {
  entryId String
  tagId   String
  userId  String
  entry   LibraryEntry @relation(fields: [entryId, userId], references: [id, userId], onDelete: Cascade)
  tag     Tag          @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId])
}

enum CompletionGoal {
  MAIN
  EXTRAS
  COMPLETIONIST
}

model ChecklistItem {
  id        String       @id @default(cuid())
  entryId   String
  userId    String
  entry     LibraryEntry @relation(fields: [entryId, userId], references: [id, userId], onDelete: Cascade)
  text      String
  completed Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([entryId, createdAt])
}

model Campaign {
  id             String         @id @default(cuid())
  entryId        String
  userId         String
  entry          LibraryEntry   @relation("EntryCampaigns", fields: [entryId, userId], references: [id, userId], onDelete: Cascade)
  activeFor      LibraryEntry[] @relation("ActiveCampaign")
  sessions       PlaySession[]
  startedAt      DateTime       @default(now())
  archivedAt     DateTime?
  status         LibraryStatus  @default(PLAYING)
  baseHours      Decimal?       @db.Decimal(6, 1)
  hoursPlayed    Decimal?       @db.Decimal(6, 1)
  rating         Int?
  notes          String?
  completedAt    DateTime?
  completionGoal CompletionGoal @default(MAIN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([id, entryId, userId])
  @@index([userId, archivedAt])
  @@index([entryId, startedAt])
}

enum SourceKind {
  STORE
  PHYSICAL
  SUBSCRIPTION
  LOAN
}

model GameSource {
  id        String       @id @default(cuid())
  entryId   String
  userId    String
  entry     LibraryEntry @relation(fields: [entryId, userId], references: [id, userId], onDelete: Cascade)
  kind      SourceKind
  label     String
  expiresAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([entryId, createdAt])
}
